# Copy to .env and fill in. NEVER commit .env.

# AthensGov Sandbox (ask the organizers for a key). Empty key = mock mode.
SANDBOX_URL=https://athensgov.cityofathens.gr/sandbox
SANDBOX_KEY=
PERSONA=p2            # p2 = retiree in Pangrati (our "Maria")
# MOCK=1              # force mock mode even with a key

# Routing (public Valhalla server; run your own with Docker if it is slow)
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Photo AI: anthropic | openai | mock
VISION_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Any OpenAI-compatible server (vLLM, Ollama, LM Studio) with a VISION model:
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llava

DUPLICATE_RADIUS_KM=0.05
CONFIDENCE_THRESHOLD=0.85

# Navigation: weather for heat-aware routing (Open-Meteo, no key). off = never call it.
WEATHER=on
HEAT_C=33

# AthensGov open data (CKAN, no key): districts, neighbourhoods, air-quality stations, municipal WiFi.
# live = call the portal and save snapshots to data/ckan/; snapshot = offline demo from saved snapshots; off = never.
CKAN_URL=https://opendata.cityofathens.gr/api/3/action
CKAN_MODE=live
# If a column is guessed wrong, name it here (see /api/city/air -> "fields"), e.g.:
# CKAN_FIELD_AQI=aqi
# CKAN_FIELD_TIME=interval_start
# CKAN_FIELD_TEMP=temperature

# Greek open model for TEXT tasks (draft replies, Ask): Llama-Krikri-8B-Instruct (ILSP, huggingface.co/ilsp)
# served by Ollama / vLLM / LM Studio on an OpenAI-compatible endpoint. Vision still needs a vision model.
# TEXT_LLM_BASE_URL=http://localhost:11434/v1
# TEXT_LLM_MODEL=krikri-8b-instruct
